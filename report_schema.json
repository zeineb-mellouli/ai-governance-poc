{
  "$defs": {
    "Finding": {
      "properties": {
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Path"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus"
        },
        "confidence_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        },
        "retrieval_chunk_id": {
          "title": "Retrieval Chunk Id",
          "type": "string"
        },
        "retrieval_score": {
          "title": "Retrieval Score",
          "type": "number"
        },
        "remediation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Remediation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remediation_status": {
          "$ref": "#/$defs/RemediationStatus",
          "default": "NOT_REQUIRED"
        },
        "remediation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Note"
        }
      },
      "required": [
        "policy_id",
        "title",
        "severity",
        "status",
        "confidence_score",
        "evidence",
        "retrieval_chunk_id",
        "retrieval_score"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingStatus": {
      "description": "The Auditor's verdict. Only the Auditor may set this.\n\nThe Remediation Agent must never write to it: whether a fix could be\ngenerated says nothing about whether the violation is real, and conflating\nthe two put 30 confidence-1.0 deterministic naming violations into the\n\"low-confidence, needs human review\" bucket. Remediation outcome lives on\nits own axis, in RemediationStatus.",
      "enum": [
        "COMPLIANT",
        "NON_COMPLIANT",
        "NOT_APPLICABLE",
        "NEEDS_REVIEW"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Remediation": {
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fix": {
          "title": "Fix",
          "type": "string"
        }
      },
      "required": [
        "description",
        "fix"
      ],
      "title": "Remediation",
      "type": "object"
    },
    "RemediationStatus": {
      "description": "What happened when we tried to produce a fix -- orthogonal to FindingStatus.",
      "enum": [
        "NOT_REQUIRED",
        "AUTO_FIXED",
        "NO_FIX_AVAILABLE",
        "UNSAFE_FIX_REJECTED",
        "SKIPPED_LOW_CONFIDENCE",
        "FAILED"
      ],
      "title": "RemediationStatus",
      "type": "string"
    }
  },
  "properties": {
    "repo_name": {
      "title": "Repo Name",
      "type": "string"
    },
    "repo_path": {
      "title": "Repo Path",
      "type": "string"
    },
    "run_timestamp": {
      "title": "Run Timestamp",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "model_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Model Fingerprints",
      "type": "array"
    }
  },
  "required": [
    "repo_name",
    "repo_path"
  ],
  "title": "ComplianceReport",
  "type": "object"
}
