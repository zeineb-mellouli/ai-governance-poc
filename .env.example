# Copy to .env and fill in. .env is gitignored; this template is not.
# Placeholder values only -- never commit a real credential here (SEC-3).

AZURE_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com/>
AZURE_OPENAI_API_KEY=<secret-never-commit>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Default self-consistency k when --samples/-k is not passed.
AGA_AUDIT_SAMPLES=3
